modules = ["python-3.11", "nodejs-20"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gettext", "glibcLocales", "unzip"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "python -m streamlit run recuperacao_senha.py --server.port 5000 --server.address 0.0.0.0"]
build = ["sh", "-c", "pip install -r requirements.txt"]

[workflows]
runButton = "Main Application"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

