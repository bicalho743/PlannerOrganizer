waitForPort = 8520

[[workflows.workflow]]
name = "API FastAPI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn api.main:api --host 0.0.0.0 --port 8000 --reload"

[[workflows.workflow]]
name = "Teste Planos"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run teste_planos.py --server.port 5010 --server.address 0.0.0.0"
