modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gettext", "glibcLocales", "unzip"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"]
build = ["sh", "-c", "pip install -r requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Login"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Login Simples"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API FastAPI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Enviar Manual Sistema"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Enviar Manual Simples"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Debug Tab Finalizadas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Debug Finalizadas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pagina Finalizadas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Debug Tab Finalizadas Novo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pagina Finalizadas 2"

[[workflows.workflow]]
name = "Gerar Manual"
author = 39445503
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run gerar_manual.py --server.port 8550 --server.address 0.0.0.0 --server.headless true"

[[workflows.workflow]]
name = "Login"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run login.py --server.port 5001 --server.address 0.0.0.0"

[[workflows.workflow]]
name = "Login Simples"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run login_simples.py --server.port 5002 --server.address 0.0.0.0"
waitForPort = 5002

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "Deploy ZIP"
author = 39445503
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run create_deployment_zip.py --server.port 8600 --server.address 0.0.0.0"

[[workflows.workflow]]
name = "API FastAPI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn api.main:api --host 0.0.0.0 --port 8000 --reload"

[[workflows.workflow]]
name = "Enviar Manual Sistema"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run enviar_manual.py --server.port 7000 --server.address 0.0.0.0"
waitForPort = 7000

[[workflows.workflow]]
name = "Enviar Manual Simples"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run enviar_manual_simples.py --server.port 5003 --server.address 0.0.0.0"
waitForPort = 5003

[[workflows.workflow]]
name = "Debug Tab Finalizadas"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run debug_tab_finalizadas.py --server.port 5004 --server.address 0.0.0.0"
waitForPort = 5004

[[workflows.workflow]]
name = "Debug Finalizadas"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run debug_propostas_finalizadas.py --server.port 5005 --server.address 0.0.0.0"
waitForPort = 5005

[[workflows.workflow]]
name = "Pagina Finalizadas"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run pagina_finalizadas.py --server.port 5004 --server.address 0.0.0.0"
waitForPort = 5004

[[workflows.workflow]]
name = "Debug Tab Finalizadas Novo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run debug_tab_finalizadas_novo.py --server.port 5010 --server.address 0.0.0.0"
waitForPort = 5010

[[workflows.workflow]]
name = "Pagina Finalizadas 2"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run pagina_finalizadas.py --server.port 5009 --server.address 0.0.0.0"
waitForPort = 5009

