modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gettext", "glibcLocales", "unzip"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"]
build = ["sh", "-c", "pip install -r requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Propostas V2"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importação Direta V2"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Examinar Tabela Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sistema de Backup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Login"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Login Simples"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Planos Simples"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Regenerar Lancamentos"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Planos Landing"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Iniciar Teste"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API FastAPI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Teste Planos"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Planos Leve"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Checkout Direto"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Teste Stripe Direto"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Login Landing"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "App Renovado"

[[workflows.workflow]]
name = "Importar Propostas"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_propostas.py --server.port 8505 --server.address 0.0.0.0"
waitForPort = 8505

[[workflows.workflow]]
name = "Limpar Clientes"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run limpar_clientes.py --server.port 8506 --server.address 0.0.0.0"
waitForPort = 8506

[[workflows.workflow]]
name = "Importar Clientes"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_clientes.py --server.port 8507 --server.address 0.0.0.0"
