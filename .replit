modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gettext", "glibcLocales", "unzip"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"]
build = ["sh", "-c", "pip install -r requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Clientes"

