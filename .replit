modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port=$PORT --server.address=0.0.0.0 --server.headless=true --server.enableCORS=false --server.enableWebsocketCompression=false"]
build = ["sh", "-c", "pip install -r requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Teste Importação"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Propostas V2"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importação Direta"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importação Direta V2"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Examinar Tabela Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ajustar Data Proposta"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sistema de Backup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Exclusão Simples"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Vendas"

[[workflows.workflow]]
name = "Teste Importação"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run teste_importacao.py --server.port 8502 --server.address 0.0.0.0 --server.headless true"
waitForPort = 8502

[[workflows.workflow]]
name = "Importar Propostas"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_propostas.py --server.port 8505 --server.address 0.0.0.0"
waitForPort = 8505

[[workflows.workflow]]
name = "Limpar Clientes"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run limpar_clientes.py --server.port 8506 --server.address 0.0.0.0"
waitForPort = 8506

[[workflows.workflow]]
name = "Importar Clientes"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_clientes.py --server.port 8507 --server.address 0.0.0.0"
waitForPort = 8507

[[workflows.workflow]]
name = "Importar Propostas V2"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_propostas_v2.py --server.port 8501 --server.address 0.0.0.0"
waitForPort = 8501

[[workflows.workflow]]
name = "Importação Direta"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importacao_direta.py --server.port 8504 --server.address 0.0.0.0"
waitForPort = 8504

[[workflows.workflow]]
name = "Importação Direta V2"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run propostas_direto.py --server.port 8510 --server.address 0.0.0.0"
waitForPort = 8510

[[workflows.workflow]]
name = "Examinar Tabela Propostas"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run examinar_tabela_propostas.py --server.port 8515 --server.address 0.0.0.0"
waitForPort = 8515

[[workflows.workflow]]
name = "Ajustar Data Proposta"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run ajustar_data_proposta.py --server.port 8520 --server.address 0.0.0.0"
waitForPort = 8520

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "Limpar Propostas"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run limpar_propostas.py --server.port 8509 --server.address 0.0.0.0"
waitForPort = 8509

[[workflows.workflow]]
name = "Sistema de Backup"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run criar_ponto_backup.py --server.port 8530 --server.address 0.0.0.0"
waitForPort = 8530

[[workflows.workflow]]
name = "Exclusão Simples"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run excluir_vendas_standalone.py --server.port 8512 --server.address 0.0.0.0"
waitForPort = 8512

[[workflows.workflow]]
