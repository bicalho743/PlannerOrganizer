modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 5000 --server.address 0.0.0.0 --server.headless true"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Personal Organizer App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Teste Importação"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Propostas"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Limpar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Importar Clientes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Debug Importação"

[[workflows.workflow]]
name = "Personal Organizer App"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"
waitForPort = 5000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run src/main.py --server.port 5000 --server.address 0.0.0.0 --server.headless true"
waitForPort = 5000

[[workflows.workflow]]
name = "Teste Importação"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run teste_importacao.py --server.port 8502 --server.address 0.0.0.0 --server.headless true"
waitForPort = 8502

[[workflows.workflow]]
name = "Importar Propostas"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_propostas.py --server.port 8505 --server.address 0.0.0.0"
waitForPort = 8505

[[workflows.workflow]]
name = "Limpar Clientes"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run limpar_clientes.py --server.port 8506 --server.address 0.0.0.0"
waitForPort = 8506

[[workflows.workflow]]
name = "Importar Clientes"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importar_clientes.py --server.port 8507 --server.address 0.0.0.0"
waitForPort = 8507

[[workflows.workflow]]
name = "Debug Importação"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run importacao_propostas_debug.py --server.port 5000 --server.address 0.0.0.0"
waitForPort = 5000

[[ports]]
localPort = 443
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8501
externalPort = 3000

[[ports]]
localPort = 8502
externalPort = 3002

[[ports]]
localPort = 8505
externalPort = 3003

[[ports]]
localPort = 8506
externalPort = 4200

[[ports]]
localPort = 8507
externalPort = 5000

[[ports]]
localPort = 8510
externalPort = 5173

[[ports]]
localPort = 8511
externalPort = 6000

[[ports]]
localPort = 8515
externalPort = 6800
