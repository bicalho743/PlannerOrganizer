[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run criar_ponto_backup.py --server.port 8530 --server.address 0.0.0.0"
waitForPort = 8530

[[workflows.workflow]]
name = "Gerar Manual"
author = 39445503
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run gerar_manual.py --server.port 8550 --server.address 0.0.0.0 --server.headless true"

[[workflows.workflow]]
name = "Login"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run login.py --server.port 5001 --server.address 0.0.0.0"
waitForPort = 5001

[[workflows.workflow]]
name = "Login Simples"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run login_simples.py --server.port 5001 --server.address 0.0.0.0 --server.headless true"
