modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gettext", "glibcLocales", "unzip"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"]
build = ["sh", "-c", "pip install -r requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API FastAPI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Gerar Manual"
author = 39445503
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run gerar_manual.py --server.port 8550 --server.address 0.0.0.0 --server.headless true"

[[workflows.workflow]]
name = "Deploy ZIP"
author = 39445503
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run create_deployment_zip.py --server.port 8600 --server.address 0.0.0.0"

[[workflows.workflow]]
name = "API FastAPI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn api.main:api --host 0.0.0.0 --port 8000"

[[workflows.workflow]]
name = "Debug Propostas"
author = 39445503
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run pages/propostas.py --server.port 5050 --server.address 0.0.0.0"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000 --server.address 0.0.0.0"
waitForPort = 5000

[[ports]]
localPort = 443
externalPort = 3001

